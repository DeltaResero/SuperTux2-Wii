# A pattern is added once the tree is able to produce the file, and is not
# taken out again afterwards. A working directory outlives the code that
# filled it, so a checkout or a bisect that crosses the commit which stopped
# generating something will still be holding the leftovers.
#
# Nothing tracked may be matched here. Check with:
#   git ls-files -i --exclude-standard -c

# Build directories
build*/

# Binaries
supertux2
supertux2.exe
test_supertux2

# Left behind by configuring in the source directory
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
install_manifest.txt
/Makefile

# Generated from .in templates
config.h
version.h
data/levels/misc/menu.stl

# Source archives from makedist.sh
supertux-*.tar.gz
supertux-*.tar.bz2

# Doxygen
Doxyfile
docs/doxygen/

# Qt Creator project file
CMakeLists.txt.user

# Windows build dependencies
Debug/
Release/
dependencies*/
tools/innosetup/Output

# Transifex client
.tx/

# Useful customization files
data/levels/more/
*.patch
*.zip
*.diff

# Annoying OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.directory
*~
